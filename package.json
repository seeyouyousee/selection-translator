{
  "name": "selection-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome 划词翻译扩展：选中网页文字，弹出窗口，双语对照（整段）或单语展示。",
  "scripts": {
    "build": "node build/build.mjs",
    "watch": "node build/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node test/smoke/run.mjs",
    "timing": "node test/smoke/timing.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "translation",
    "bilingual",
    "openai",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  }
}
